# Backend URL used server-side by Next.js rewrites (metadata proxy)
# Default: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Backend URL used client-side for direct video uploads (bypasses Next.js proxy body limit)
# Must be reachable from the browser. Default: http://localhost:8000
# In production set this to your public FastAPI URL, e.g. https://api.tubeflow.io
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
